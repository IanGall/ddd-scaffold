<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.iantech</groupId>
        <artifactId>ddd-base</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../ddd/ddd-base/pom.xml</relativePath>
    </parent>

    <artifactId>ddd-scaffold-parent</artifactId>
    <packaging>pom</packaging>

    <name>ddd-scaffold-parent</name>
    <description>DDD 工程骨架（Maven Archetype）聚合工程</description>

    <modules>
        <module>scaffold-std</module>
        <module>scaffold-gateway</module>
        <!-- 模板护栏：maven-archetype 生命周期无 test 阶段，护栏测试放在 jar 模块中执行 -->
        <module>scaffold-template-guard</module>
    </modules>

    <properties>
        <maven.archetype.plugin.version>3.4.1</maven.archetype.plugin.version>
    </properties>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
</project>
