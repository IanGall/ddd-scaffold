<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor name="scaffold-gateway"
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd">
    <requiredProperties>
        <requiredProperty key="uAppName">
            <defaultValue>Gateway</defaultValue>
        </requiredProperty>
        <requiredProperty key="rootArtifactId">
            <defaultValue>${artifactId}</defaultValue>
        </requiredProperty>
    </requiredProperties>
    <fileSets>
        <fileSet filtered="true" encoding="UTF-8">
            <directory/>
            <includes>
                <include>pom.xml</include>
                <include>README.md</include>
                <include>agents.md</include>
                <include>Dockerfile</include>
                <include>__gitignore__</include>
                <include>.env.example</include>
                <!-- 构建上下文剔除项：与参考实现 gateway-app 保持一致，避免把本地日志打进构建上下文 -->
                <include>.dockerignore</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>application*.yml</include>
                <!-- 与参考实现一致：网关日志需带 trace-id 且落盘，模板必须一并生成 -->
                <include>logback-spring.xml</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <!-- 非过滤：脚本内含 shell 的 ${VAR:-default} 语法，不能让模板引擎解析 -->
        <fileSet encoding="UTF-8">
            <directory>dev-ops</directory>
            <includes>
                <include>**/*.sh</include>
            </includes>
        </fileSet>
        <!--
            k8s 部署清单：镜像名与资源名来自模板变量，必须开启 Velocity 过滤（filtered="true"），
            否则生成物里会残留字面量占位符、kubectl apply 直接失败。
            规则：YAML 正文只通过 envFrom 注入环境变量；确需在模板里书写字面量占位符时，必须使用
            Velocity 的转义形式（symbol_dollar 变量，本目录其它模板文件里已有先例），不能裸写。
            反向约束：filtered 非 true 的 fileSet 会被 scaffold-template-guard 扫描，文件内一旦出现该转义
            变量就测挂，因此上面的 dev-ops/**/*.sh 与本 fileSet 的 filtered 值都不能随手改。
            include 说明：**/*.yaml 不匹配 secret.yaml.example（它以 .example 结尾），故单独列出；
            该扩展名是刻意的 —— kubectl apply -f <目录> 只收集 .yaml/.yml/.json，示例文件不会被误 apply。
        -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>dev-ops/k8s</directory>
            <includes>
                <include>**/*.yaml</include>
                <include>**/*.yaml.example</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
