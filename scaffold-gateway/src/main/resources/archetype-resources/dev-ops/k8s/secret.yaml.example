# 敏感配置「键名样例」——不是可直接使用的凭证，请勿 apply 本文件。
#
# 真实 Secret 用命令式创建：
#   kubectl create secret generic ${rootArtifactId}-secret -n <namespace> \
#     --from-literal=DUBBO_REGISTRY_PASSWORD='...'
#
# 网关只依赖注册中心凭据：认证与鉴权都通过 Dubbo 调用后端服务，网关自身不持有数据库、Redis 或渠道密钥。
apiVersion: v1
kind: Secret
metadata:
  name: ${rootArtifactId}-secret
  labels:
    app.kubernetes.io/name: ${rootArtifactId}
type: Opaque
stringData:
  DUBBO_REGISTRY_PASSWORD: REPLACE_ME
