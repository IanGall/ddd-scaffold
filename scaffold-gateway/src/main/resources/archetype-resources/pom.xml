<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.iantech</groupId>
        <artifactId>ddd-base</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <name>${rootArtifactId}</name>
    <description>${uAppName} 通用网关</description>

    <properties>
        <ddd.base.version>1.0-SNAPSHOT</ddd.base.version>
        <gateway.core.version>1.0-SNAPSHOT</gateway.core.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!--
          本模板是「平台认证网关」：认证转发（AdminAuth/AppAuth）与 RBAC 管理端代理都直接使用
          平台认证契约 cn.iantech.api.*，因此必须依赖认证契约制品。
          契约统一放在共享契约仓 ian-ddd-api 的 ian-ddd-api-internal/<service>-api，
          版本由 ddd-base-bom 统一管理（此处不写版本）。
          若你的平台认证契约制品名不同，只需改这一处属性。
        -->
        <auth.contract.artifactId>ian-ddd-auth-api</auth.contract.artifactId>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ddd-base-bom</artifactId>
                <version>${ddd.base.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ian-ddd-gateway-core</artifactId>
                <version>${gateway.core.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.iantech</groupId>
            <artifactId>ian-ddd-gateway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>cn.iantech</groupId>
            <artifactId>ddd-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iantech</groupId>
            <!-- 平台认证契约（见 properties 中的 auth.contract.artifactId 说明） -->
            <artifactId>${auth.contract.artifactId}</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iantech</groupId>
            <artifactId>ddd-context-dubbo</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>${package}.${uAppName}Application</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
